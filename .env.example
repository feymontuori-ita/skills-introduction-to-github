# ── Supabase (Project Settings → API) ──────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server-only. Used later by the reminder cron. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Who's allowed in (server-only) ─────────────────────────────
ALLOWED_EMAIL=you@example.com

# ── AI coach (step 3) ──────────────────────────────────────────
AI_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=                  # also used for transcription (step 4)
OPENAI_MODEL=

# ── Web Push (step 5) — generate with: npx web-push generate-vapid-keys ──
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=
